{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/command-centre.html",
      "destination": "/console.html",
      "permanent": false
    }
  ],
  "functions": {
    "api/check-uptime.js": {
      "maxDuration": 20
    }
  }
}
